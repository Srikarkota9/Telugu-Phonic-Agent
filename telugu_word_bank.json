    "nursery_rhymes": {
      "label": "Nursery Rhymes",
      "rhymes": [
        {
          "title": "Veeri Veeri Gummadi Pandu",
          "title_telugu": "వీరి వీరి గుమ్మడి పండు",
          "english_meaning": "A playful children's rhyme about a pumpkin and running away",
          "verses": [
            {
              "verse_number": 1,
              "telugu": "వీరి వీరి గుమ్మడి పండు, వీరి పేరేమి,\nదాగుడు మూతల దండకోరు వీరి పేరేమి\nపింకీ… పారిపో.\n\nతార్ మార్ తత్తర్మర్, తార్ మార్ తత్తర్మర్!!",
              "romanized": "Veeri veeri gummadi pandu, veeri peremi,\nDaagudu muthala dhandakoru veeri peremi\nPinky… paaripo.\n\nTaar maar tattharmar, taar maar tattharmar!!"
            },
            {
              "verse_number": 2,
              "telugu": "వీరి వీరి గుమ్మడి పండు, వీరి పేరేమి,\nదాగుడు మూతల దండకోరు వీరి పేరేమి\nగుడ్డు… పారిపో.\n\nతార్ మార్ తిత్తర్మర్, తార్ మార్ తత్తర్మర్!!",
              "romanized": "Veeri veeri gummadi pandu, veeri peremi,\nDaagudu muthala dhandakoru veeri peremi\nGuddu… paaripo.\n\nTaar maar tittharmar, taar maar tattharmar!!"
            },
            {
              "verse_number": 3,
              "telugu": "వీరి వీరి గుమ్మడి పండు, వీరి పేరేమి,\nదాగుడు మూతల దండకోరు వీరి పేరేమి\nషోనా… పారిపో.\n\nతార్ మార్ తిత్తర్మర్, తార్ మార్ తత్తర్మర్!!",
              "romanized": "Veeri veeri gummadi pandu, veeri peremi,\nDaagudu muthala dhandakoru veeri peremi\nShona… paaripo.\n\nTaar maar tittharmar, taar maar tattharmar!!"
            },
            {
              "verse_number": 4,
              "telugu": "వీరి వీరి గుమ్మడి పండు, వీరి పేరేమి,\nదాగుడు మూతల దండకోరు వీరి పేరేమి\nచింటు… పారిపో.\n\nతార్ మార్ తిత్తర్మర్, తార్ మార్ తత్తర్మర్!!\nఎక్కడి దొంగలు అక్కడే, సాంబార్ బుద్ధి!",
              "romanized": "Veeri veeri gummadi pandu, veeri peremi,\nDaagudu muthala dhandakoru veeri peremi\nChintu… paaripo.\n\nTaar maar tittharmar, taar maar tattharmar!!\nEkkadi dongalu akkade, sambar buddi!"
            }
          ]
        },
        {
          "title": "Jo Achyutananda",
          "title_telugu": "జో అచ్యుతానంద",
          "english_meaning": "A traditional Telugu lullaby invoking Lord Vishnu's names to soothe a child to sleep",
          "verses": [
            {
              "verse_number": 1,
              "telugu": "జో అచ్యుతానంద జోజో ముకుందా\nరావే పరమానంద రామ గోవిందా\nజో జో",
              "romanized": "Jō achyutānanda jōjō mukundā\nRāve paramānanda rāma gōvindā\nJō jō"
            }
          ]
        }
      ]
    }
